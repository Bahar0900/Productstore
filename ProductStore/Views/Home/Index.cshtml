@model List<Product>
@{
    ViewData["Title"] = "Storefront - Discover Products";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCat = ViewBag.CurrentCategory as string ?? "All";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentSort = ViewBag.CurrentSort as string ?? "newest";
}

@* Hero Banner *@
<div class="p-4 p-md-5 mb-4 rounded-3 text-white bg-dark shadow position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="col-md-8 py-3">
        <span class="badge bg-warning text-dark text-uppercase px-3 py-2 mb-3 fw-bold"><i class="fa-solid fa-bolt me-1"></i> Launching New Tech & Gadgets</span>
        <h1 class="display-5 fw-bold">Welcome to ProductStore Marketplace</h1>
        <p class="fs-5 text-light opacity-75">
            Discover premium laptops, smartphones, peripherals, and accessories. Buy securely with Mobile Banking (bKash/Nagad/Rocket) or Direct Bank Transfer!
        </p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a href="#productCatalog" class="btn btn-warning btn-lg px-4 fw-semibold"><i class="fa-solid fa-basket-shopping me-2"></i> Shop Now</a>
            @if (!User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4"><i class="fa-solid fa-user-plus me-2"></i> Join as Seller or Customer</a>
            }
        </div>
    </div>
</div>

@* Search & Filter Controls *@
<div id="productCatalog" class="card shadow-sm mb-4 border-0">
    <div class="card-body p-3">
        <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search products, brands, or descriptions..." value="@currentSearch">
                </div>
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select">
                    <option value="All" selected="@(currentCat == "All")">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(currentCat == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="sort" class="form-select">
                    <option value="newest" selected="@(currentSort == "newest")">Newest First</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Price: High to Low</option>
                    <option value="name" selected="@(currentSort == "name")">Name (A-Z)</option>
                </select>
            </div>
            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter"></i></button>
            </div>
        </form>
    </div>
</div>

@* Product Grid *@
@if (!Model.Any())
{
    <div class="text-center py-5 bg-white rounded shadow-sm">
        <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
        <h4 class="fw-bold">No Products Found</h4>
        <p class="text-muted">No products match your current search criteria. Try a different keyword or reset filters.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Reset Filters</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative d-flex flex-column">
                    <div class="position-absolute top-0 start-0 m-2 z-1">
                        <span class="badge bg-dark bg-opacity-75">@product.Category</span>
                    </div>
                    @if (product.StockQuantity <= 0)
                    {
                        <div class="position-absolute top-0 end-0 m-2 z-1">
                            <span class="badge bg-danger">Out of Stock</span>
                        </div>
                    }
                    else if (product.StockQuantity <= 5)
                    {
                        <div class="position-absolute top-0 end-0 m-2 z-1">
                            <span class="badge bg-warning text-dark">Only @product.StockQuantity Left</span>
                        </div>
                    }

                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                        <div class="bg-white p-3 text-center d-flex align-items-center justify-content-center" style="height: 220px;">
                            <img src="/ProductImages/@product.ImageFileName" class="img-fluid rounded" style="max-height: 190px; object-fit: contain;" alt="@product.Name" onerror="this.src='https://via.placeholder.com/300x200?text=Product+Image'">
                        </div>
                    </a>

                    <div class="card-body d-flex flex-column p-3">
                        <div class="text-muted small mb-1 fw-semibold text-uppercase">@product.Brand</div>
                        <h6 class="card-title fw-bold mb-2">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none text-truncate d-block" title="@product.Name">
                                @product.Name
                            </a>
                        </h6>
                        <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @product.Description
                        </p>

                        <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                            <div>
                                <span class="fs-5 fw-bold text-primary">$@product.Price.ToString("F2")</span>
                            </div>
                            <div class="small text-muted">
                                @if (product.Owner != null)
                                {
                                    <span title="Seller"><i class="fa-solid fa-store me-1"></i>@product.Owner.FullName</span>
                                }
                            </div>
                        </div>

                        <div class="mt-3 d-grid gap-2">
                            @if (product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-warning fw-semibold">
                                        <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary disabled" disabled>Out of Stock</button>
                            }
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
