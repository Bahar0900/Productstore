@model ProductDto
@{
    ViewData["Title"] = "Launch New Product";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-plus-circle me-2 text-warning"></i> Launch New Product</h5>
                <a class="btn btn-sm btn-outline-light" asp-controller="Products" asp-action="Index">Cancel</a>
            </div>
            <div class="card-body p-4 p-md-5">
                <form method="post" enctype="multipart/form-data" asp-controller="Products" asp-action="Create">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Product Name</label>
                            <input class="form-control" asp-for="Name" placeholder="e.g. Dell XPS 15 Laptop">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label fw-semibold">Brand</label>
                            <input class="form-control" asp-for="Brand" placeholder="e.g. Dell, Apple, Samsung">
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">Category</label>
                            <select class="form-select" asp-for="Category">
                                <option value="Computers">Computers & Laptops</option>
                                <option value="Phones">Phones & Tablets</option>
                                <option value="Accessories">Accessories & Peripherals</option>
                                <option value="Audio">Headphones & Audio</option>
                                <option value="Printers">Printers & Scanners</option>
                                <option value="Other">Other Electronics</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Price ($ USD)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" asp-for="Price" placeholder="0.00" type="number" step="0.01">
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-semibold">Initial Stock Quantity</label>
                            <input class="form-control" asp-for="StockQuantity" type="number" min="0" value="20">
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageFile" class="form-label fw-semibold">Product Image</label>
                            <input type="file" class="form-control" asp-for="ImageFile" accept="image/*">
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Detailed Description</label>
                            <textarea class="form-control" asp-for="Description" rows="4" placeholder="Enter key features, technical specs, warranty information..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" checked />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">
                                    Make product active & visible on marketplace immediately
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary px-4" asp-controller="Products" asp-action="Index">Cancel</a>
                        <button type="submit" class="btn btn-warning px-5 fw-bold text-dark">
                            <i class="fa-solid fa-cloud-arrow-up me-1"></i> Launch Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
