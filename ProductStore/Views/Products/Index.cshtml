@model List<Product>
@using System.Security.Claims
@{
    ViewData["Title"] = "Product Catalog";
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(userIdClaim, out int currentUserId);
    var isAdmin = User.IsInRole(UserRoles.Admin);
    var isSeller = User.IsInRole(UserRoles.ProductOwner);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i>Product Catalog</h2>
        <p class="text-muted mb-0">Browse through all active products and inventory</p>
    </div>
    @if (isAdmin || isSeller)
    {
        <a class="btn btn-warning fw-semibold shadow-sm" asp-controller="Products" asp-action="Create">
            <i class="fa-solid fa-plus-circle me-1"></i> Launch New Product
        </a>
    }
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Seller</th>
                        <th>Created</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                                No products found in the catalog.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            var canManage = isAdmin || (isSeller && product.OwnerId == currentUserId);
                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@product.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="/ProductImages/@product.ImageFileName" width="55" height="55" class="rounded border object-fit-contain bg-white" alt="@product.Name" onerror="this.src='https://via.placeholder.com/55?text=No+Img'">
                                        <div>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="fw-bold text-dark text-decoration-none">
                                                @product.Name
                                            </a>
                                            <div class="small text-muted">@product.Brand</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">@product.Category</span></td>
                                <td class="fw-bold text-primary">$@product.Price.ToString("F2")</td>
                                <td>
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                    else if (product.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-warning text-dark">Low: @product.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@product.StockQuantity in stock</span>
                                    }
                                </td>
                                <td class="small">
                                    @(product.Owner?.FullName ?? "Official Store")
                                </td>
                                <td class="small text-muted">@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-3 text-nowrap">
                                    <a class="btn btn-sm btn-outline-info" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" title="Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (canManage)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" title="Edit">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this product?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
