@model SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Hub - Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-shop text-warning me-2"></i> Seller Hub & Inventory</h2>
        <p class="text-muted mb-0">Manage your product catalog, monitor stock levels, and review customer sales</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Create" class="btn btn-warning fw-semibold text-dark shadow-sm">
            <i class="fa-solid fa-plus-circle me-1"></i> Launch New Product
        </a>
        <a asp-controller="Seller" asp-action="SalesOrders" class="btn btn-outline-dark">
            <i class="fa-solid fa-receipt me-1"></i> View Customer Orders
        </a>
    </div>
</div>

@* KPI Stat Cards *@
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 bg-white p-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase">My Active Products</div>
            <h3 class="fw-bold text-primary my-1">@Model.TotalProducts</h3>
            <div class="small text-muted">Launched by you</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 bg-white p-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase">Total Units Sold</div>
            <h3 class="fw-bold text-success my-1">@Model.TotalItemsSold</h3>
            <div class="small text-muted">To marketplace customers</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 bg-white p-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase">Total Sales Revenue</div>
            <h3 class="fw-bold text-success my-1">$@Model.TotalEarnings.ToString("F2")</h3>
            <div class="small text-muted">Gross product sales</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-3 bg-white p-3 text-center">
            <div class="text-muted small fw-semibold text-uppercase">Low Stock Alerts</div>
            <h3 class="fw-bold @(Model.LowStockProducts > 0 ? "text-danger" : "text-muted") my-1">@Model.LowStockProducts</h3>
            <div class="small text-muted">&le; 5 units remaining</div>
        </div>
    </div>
</div>

@* My Products Inventory Table *@
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-boxes-stacked me-2 text-warning"></i> My Products Inventory</h5>
        <a asp-controller="Products" asp-action="Create" class="btn btn-sm btn-outline-warning">Add Product</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Level</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.MyProducts.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                You haven't launched any products yet.
                                <div class="mt-2">
                                    <a asp-controller="Products" asp-action="Create" class="btn btn-sm btn-warning fw-semibold">Launch Your First Product</a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model.MyProducts)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@product.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="/ProductImages/@product.ImageFileName" width="45" height="45" class="rounded border object-fit-contain bg-white" alt="@product.Name" onerror="this.src='https://via.placeholder.com/45'">
                                        <div>
                                            <div class="fw-bold">@product.Name</div>
                                            <div class="small text-muted">@product.Brand</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">@product.Category</span></td>
                                <td class="fw-bold text-primary">$@product.Price.ToString("F2")</td>
                                <td>
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                    else if (product.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-warning text-dark">Low: @product.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@product.StockQuantity</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">@(product.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td class="small text-muted">@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-primary" title="Edit Product">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Product">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
