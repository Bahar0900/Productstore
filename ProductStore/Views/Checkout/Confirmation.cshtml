@model Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8">
        <div class="card shadow border-0 rounded-3 text-center p-4 mb-4 bg-white">
            <div class="mb-3 text-success">
                <i class="fa-solid fa-circle-check fa-4x"></i>
            </div>
            <h2 class="fw-bold text-success mb-1">Thank You! Order Placed Successfully</h2>
            <p class="text-muted mb-3">Your order reference is <strong class="text-dark">@Model.OrderNumber</strong></p>

            <div class="d-flex justify-content-center gap-2 mb-2">
                <span class="badge bg-primary fs-6 px-3 py-2"><i class="fa-solid fa-clock me-1"></i> Status: @Model.OrderStatus</span>
                <span class="badge bg-secondary fs-6 px-3 py-2"><i class="fa-solid fa-money-bill me-1"></i> Payment: @(Model.Payment?.PaymentMethod ?? "CashOnDelivery") (@(Model.Payment?.Status ?? "Pending"))</span>
            </div>
        </div>

        @* Order Summary & Receipt *@
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice me-2 text-warning"></i> Invoice Summary</h5>
                <span class="small text-muted">@Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-uppercase small text-muted mb-2">Shipping Information</h6>
                        <div class="fw-bold">@Model.ShippingFullName</div>
                        <div class="text-muted small">@Model.ShippingEmail</div>
                        <div class="text-muted small">Phone: @Model.ShippingPhone</div>
                        <div class="text-secondary small mt-1">@Model.ShippingAddress</div>
                        @if (!string.IsNullOrEmpty(Model.OrderNotes))
                        {
                            <div class="small text-info mt-1"><i class="fa-solid fa-note-sticky me-1"></i> Note: @Model.OrderNotes</div>
                        }
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold text-uppercase small text-muted mb-2">Payment Transaction Details</h6>
                        <div class="text-dark">Method: <strong>@Model.Payment?.PaymentMethod</strong></div>
                        <div class="text-dark">Provider: <strong>@Model.Payment?.Provider</strong></div>
                        @if (!string.IsNullOrEmpty(Model.Payment?.AccountNumber))
                        {
                            <div class="small text-muted">Account: @Model.Payment.AccountNumber</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Payment?.TransactionId))
                        {
                            <div class="small text-muted">TrxID / Reference: <code class="fw-bold text-dark">@Model.Payment.TransactionId</code></div>
                        }
                        <div class="mt-1">
                            Status: <span class="badge @(Model.Payment?.Status == PaymentStatuses.Verified ? "bg-success" : "bg-warning text-dark")">@Model.Payment?.Status</span>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Unit Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.Product.Name</div>
                                        <div class="small text-muted">@item.Product.Brand</div>
                                    </td>
                                    <td>$@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end fw-semibold">$@item.TotalPrice.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Subtotal:</th>
                                <th class="text-end">$@Model.SubTotal.ToString("F2")</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end">Shipping Fee:</th>
                                <th class="text-end">$@Model.ShippingFee.ToString("F2")</th>
                            </tr>
                            <tr class="table-dark">
                                <th colspan="3" class="text-end fs-5">Total Paid / Due:</th>
                                <th class="text-end fs-5 text-warning">$@Model.TotalAmount.ToString("F2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-outline-primary">
                    <i class="fa-solid fa-box-open me-1"></i> Track in My Orders
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-warning fw-semibold text-dark">
                    <i class="fa-solid fa-store me-1"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
