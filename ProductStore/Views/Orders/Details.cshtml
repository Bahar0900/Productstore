@model Order
@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
    var statusBadge = Model.OrderStatus switch
    {
        OrderStatuses.Delivered => "bg-success",
        OrderStatuses.Shipped => "bg-primary",
        OrderStatuses.Processing => "bg-info text-dark",
        OrderStatuses.Cancelled => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i> Order @Model.OrderNumber</h2>
        <span class="badge @statusBadge fs-6">Order Status: @Model.OrderStatus</span>
    </div>
    <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Orders
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-boxes-packing me-2 text-warning"></i> Items in this Order</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Product</th>
                                <th>Unit Price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end pe-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="/ProductImages/@item.Product.ImageFileName" width="50" height="50" class="rounded border object-fit-contain bg-white" alt="@item.Product.Name">
                                            <div>
                                                <div class="fw-bold">@item.Product.Name</div>
                                                <div class="small text-muted">@item.Product.Brand | @item.Product.Category</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>$@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-center fw-bold">@item.Quantity</td>
                                    <td class="text-end pe-3 fw-bold text-primary">$@item.TotalPrice.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end">Subtotal:</th>
                                <th class="text-end pe-3">$@Model.SubTotal.ToString("F2")</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end">Shipping Fee:</th>
                                <th class="text-end pe-3">$@Model.ShippingFee.ToString("F2")</th>
                            </tr>
                            <tr class="table-dark">
                                <th colspan="3" class="text-end fs-5">Total Amount:</th>
                                <th class="text-end pe-3 fs-5 text-warning">$@Model.TotalAmount.ToString("F2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @* Shipping Card *@
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-location-dot me-2 text-warning"></i> Delivery Details</h5>
            </div>
            <div class="card-body p-3">
                <div class="fw-bold">@Model.ShippingFullName</div>
                <div class="small text-muted mb-1"><i class="fa-solid fa-envelope me-1"></i> @Model.ShippingEmail</div>
                <div class="small text-muted mb-2"><i class="fa-solid fa-phone me-1"></i> @Model.ShippingPhone</div>
                <div class="small text-secondary border-top pt-2">@Model.ShippingAddress</div>
                @if (!string.IsNullOrEmpty(Model.OrderNotes))
                {
                    <div class="small text-info mt-2"><i class="fa-solid fa-note-sticky me-1"></i> Note: @Model.OrderNotes</div>
                }
            </div>
        </div>

        @* Payment Card *@
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-credit-card me-2 text-warning"></i> Payment Status</h5>
            </div>
            <div class="card-body p-3">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Method:</span>
                    <span class="fw-semibold">@Model.Payment?.PaymentMethod</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Provider:</span>
                    <span class="fw-semibold">@Model.Payment?.Provider</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Payment?.TransactionId))
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">TrxID / Ref:</span>
                        <code>@Model.Payment.TransactionId</code>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Verification Status:</span>
                    <span class="badge @(Model.Payment?.Status == PaymentStatuses.Verified ? "bg-success" : "bg-warning text-dark")">@Model.Payment?.Status</span>
                </div>
                @if (Model.Payment?.VerifiedAt.HasValue == true)
                {
                    <div class="small text-muted text-end">Verified on @Model.Payment.VerifiedAt.Value.ToString("MMM dd, yyyy HH:mm")</div>
                }
            </div>
        </div>
    </div>
</div>
