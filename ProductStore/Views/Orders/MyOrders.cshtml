@model List<Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-truck-fast text-primary me-2"></i> My Orders</h2>
        <p class="text-muted mb-0">Track and view history of all your placed orders</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Continue Shopping
    </a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 rounded-3 py-5 text-center bg-white">
        <div class="card-body">
            <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
            <h4 class="fw-bold">No Orders Placed Yet</h4>
            <p class="text-muted">You haven't purchased any items on ProductStore yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning px-4 fw-semibold mt-2">
                <i class="fa-solid fa-basket-shopping me-1"></i> Start Shopping
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Order Number</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Payment Method</th>
                            <th>Payment Status</th>
                            <th>Order Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var statusBadge = order.OrderStatus switch
                            {
                                OrderStatuses.Delivered => "bg-success",
                                OrderStatuses.Shipped => "bg-primary",
                                OrderStatuses.Processing => "bg-info text-dark",
                                OrderStatuses.Cancelled => "bg-danger",
                                _ => "bg-warning text-dark"
                            };

                            var paymentBadge = order.Payment?.Status switch
                            {
                                PaymentStatuses.Verified => "bg-success",
                                PaymentStatuses.Failed => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-3 fw-bold">@order.OrderNumber</td>
                                <td class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td>@order.OrderItems.Sum(oi => oi.Quantity) items</td>
                                <td class="fw-bold text-primary">$@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    <span class="small fw-semibold">@(order.Payment?.PaymentMethod ?? "COD")</span>
                                    @if (!string.IsNullOrEmpty(order.Payment?.Provider))
                                    {
                                        <div class="small text-muted">(@order.Payment.Provider)</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @paymentBadge">@(order.Payment?.Status ?? "Pending")</span>
                                </td>
                                <td>
                                    <span class="badge @statusBadge">@order.OrderStatus</span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
