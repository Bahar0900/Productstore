@{
    ViewData["Title"] = "Access Denied - ProductStore";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card shadow border-0 rounded-3 p-5">
            <div class="mb-3 text-danger">
                <i class="fa-solid fa-ban fa-4x"></i>
            </div>
            <h2 class="fw-bold text-danger">Access Denied</h2>
            <p class="text-muted">
                You do not have the required permissions or role to access this section of the website.
            </p>
            <div class="mt-4 d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="fa-solid fa-house me-1"></i> Return Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
